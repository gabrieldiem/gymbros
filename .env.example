# Copy to .env (`cp .env.example .env`) and replace the REPLACE_ values. Never commit .env.

# ===== App =====
# development | test | production. docker-compose.yaml (make prod) always runs production.
APP_ENV=development
LOG_LEVEL=INFO
# Uvicorn workers in the production api container.
WEB_CONCURRENCY=2

# ===== Postgres =====
# The compose files override POSTGRES_HOST to the `postgres` service. localhost is for running
# the api natively against the dev postgres (published on 127.0.0.1:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gymbros
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=gymbros
# The test suite always uses its own database (created and migrated on first run).
# TEST_POSTGRES_DB=gymbros_test

# ===== Auth =====
# Signs session tokens. At least 32 characters in production: `openssl rand -hex 32`.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Send the session cookie over HTTPS only. Keep false for http://localhost; true behind TLS.
COOKIE_SECURE=false

# ===== Host ports =====
API_HOST_PORT=8080
WEB_DEV_PORT=5173
POSTGRES_HOST_PORT=5432
# nginx (make prod)
WEB_HOST_PORT=8081

# ===== Game tuning overrides (optional) =====
# Any key in apps/api/settings.json can be overridden as UPPERCASE_FLAT_NAME, e.g.:
# SCORING_PR=120
# GAME_WEEKLY_TARGET=3
