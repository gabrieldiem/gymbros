FROM python:3.13-slim-trixie

# Set working directory inside the container
WORKDIR /app

# Copy only dependency manifests first (to leverage Docker build cache for faster builds)
COPY pyproject.toml poetry.lock* /app/

# Install Poetry (dependency manager) globally, disable venvs to install into system site-packages
RUN pip install --no-cache-dir "poetry==2.3.2" && poetry config virtualenvs.create false

# Verify that poetry.lock matches pyproject.toml, regenerate if out of date
# Install all dependencies, tests need dev dependencies as well
# "--no-root" avoids installing this project package itself, since tests run against the source
RUN (poetry check --lock || poetry lock) && poetry install --no-root --no-cache

# Copy the rest of the project files (source code, tests, configs, migrations, etc.)
COPY . .

# Run pytest against the Postgres given by POSTGRES_HOST (the compose `postgres` service via
# `make test-api`). The suite creates and migrates its own `gymbros_test` database.
# -m "not skip"     : skip tests marked @pytest.mark.skip
# --color=yes       : force colored output even in Docker/CI logs
# --junitxml=...    : JUnit XML report
# --cov=src         : coverage for "src" package
# --cov-report=html : export HTML coverage report under reports/coverage
CMD ["poetry", "run", "pytest", "-m", "not skip", "--color=yes", "--junitxml=reports/junit_report.xml", "--cov=src", "--cov-report", "term", "--cov-report", "html:reports/coverage", "-W", "ignore::DeprecationWarning"]
