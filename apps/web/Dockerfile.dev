# Vite dev server with hot reload. The source is mounted at /app by docker-compose-dev.yaml;
# node_modules stays in the image (an anonymous volume keeps the host's out).
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json /app/
RUN npm ci --no-audit --no-fund

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
